<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- net10.0 es la versión principal (LTS vigente). net8.0 se mantiene porque los consumidores actuales
         siguen en .NET 8; se retira en una versión mayor cuando migren. -->
    <TargetFrameworks>net10.0;net8.0</TargetFrameworks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Version>2.0.0</Version>
    <Authors>Julio Cesar Bautista Monsalvo</Authors>
    <Company>JCBM</Company>
    <Product>EstatusCFDI.Sat</Product>
    <PackageId>EstatusCFDI.Sat</PackageId>
    <Description>Consulta si un CFDI está vigente o cancelado en el servicio oficial del SAT (ConsultaCFDIService). Resultado tipado que distingue "vigente", "cancelado", "no encontrado" y "sin respuesta", timeout configurable, lectura directa del XML timbrado e integración con IHttpClientFactory.</Description>
    <PackageTags>CFDI;SAT;Facturación;México;Estatus;Cancelación;Vigencia</PackageTags>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/Juliocbm/EstatusCFDI.Sat</RepositoryUrl>
    <PackageProjectUrl>https://github.com/Juliocbm/EstatusCFDI.Sat</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageIcon>icono.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <!-- El empaquetado es un paso explícito (dotnet pack en CI); GeneratePackageOnBuild empaqueta en cada build local. -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <PackageReleaseNotes>v2.0.0 (BREAKING, ver MIGRATION.md): reconstrucción sin WCF sobre HttpClient. Resultado tipado (EstadoConsulta: Vigente, Cancelado, NoEncontrado, ExpresionInvalida, SinRespuesta, RespuestaNoReconocida), timeout configurable y CancellationToken, lectura del XML timbrado (DatosConsultaCfdi.DesdeXml), registro con AddEstatusCfdiSat, RFC con '&amp;' soportado, net10.0 y net8.0.</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="EstatusCFDI.Sat.Tests" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <PackageReference Include="Microsoft.Extensions.Http" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\icono.png" Pack="true" PackagePath="\" />
    <None Include="..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\CHANGELOG.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
